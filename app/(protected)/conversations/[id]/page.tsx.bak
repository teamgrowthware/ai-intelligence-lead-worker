import { MessageService } from "@/services/MessageService";
import { auth, prisma } from "@/auth";
import { sendMessageAction } from "./actions";
import Link from "next/link";
import { redirect } from "next/navigation";

export default async function ConversationDetailPage({ params }: { params: { id: string } }) {
  const session = await auth();
  const workspaceId = (session?.user as unknown as { workspaceId: string })?.workspaceId;
  if (!workspaceId) redirect("/login");
  
  const conversation = await MessageService.getConversation(workspaceId, params.id);
  if (!conversation) return <div>Not found</div>;

  return (
    <div className="p-8">
      <Link href="/conversations" className="text-blue-500 mb-4 inline-block">&larr; Back to Conversations</Link>
      <h1 className="text-2xl font-bold mb-4">Conversation with {conversation.lead.companyId || 'Lead'} ({conversation.channel})</h1>
      
      <div className="border rounded p-4 h-96 overflow-y-auto mb-4 space-y-4">
        {conversation.messages.map(msg => (
          <div key={msg.id} className={`p-3 rounded max-w-[80%] ${msg.direction === 'OUTBOUND' ? 'bg-blue-100 ml-auto' : 'bg-gray-100'}`}>
            <div className="text-sm font-semibold">{msg.direction === 'OUTBOUND' ? 'You' : 'Lead'}</div>
            <div>{msg.content}</div>
            <div className="text-xs text-gray-500 mt-1">{new Date(msg.createdAt).toLocaleString()} - {msg.status}</div>
          </div>
        ))}
        {conversation.messages.length === 0 && <div className="text-gray-500 text-center">No messages yet.</div>}
      </div>

      <form action={async (formData) => {
        "use server"
        const content = formData.get("content") as string;
        if (content) await sendMessageAction(params.id, content);
      }} className="flex gap-2">
        <input type="text" name="content" className="flex-1 border rounded p-2" placeholder="Type a message..." required />
        <button type="submit" className="bg-blue-600 text-white px-4 py-2 rounded">Send</button>
      </form>
    </div>
  );
}
